# ---- Server ----
PORT=3000
NODE_ENV=development
# سلسلة عشوائية طويلة (إلزامية في الإنتاج). مثال لتوليدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- PostgreSQL ----
DATABASE_URL=postgres://fcdc:fcdc@localhost:5432/fcdc
# اجعلها true عند استخدام قاعدة بيانات سحابية تتطلب SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# ---- First admin account (created by `npm run db:init` if no admin exists) ----
ADMIN_NAME=مدير المنظومة
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---- Storage for uploaded photos ----
UPLOAD_DIR=./uploads

# ---- التقارير الرسمية ----
# الرابط العام للموقع: يُطبع داخل رمز QR للتحقق من التقارير (اتركه فارغًا لاستخدام عنوان الطلب الحالي)
PUBLIC_URL=
# مسار Chrome لتوليد PDF (يُكتشف تلقائيًا في Docker وعلى Windows/Mac عادةً)
CHROME_PATH=
# أول شهر في المشروع (للتقارير وقوائم الشهور)
START_MONTH=2024-09
